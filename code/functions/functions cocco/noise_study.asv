function noise_study(img,idl,idc)

    imgs = squeeze(img);
    nk = size(imgs,3);
    % imgs_mean = mean(imgs,3);

    line = zeros(nk,size(imgs,1));
    column = zeros(nk,size(imgs,2));

    for k = 1:nk
        line(k,:)=imgs(:,idc,k);
        column(k,:)=imgs(idl,:,k);
    end

    figure(); 
    color = ['r','b','g','k','c','y']

    subplot(1,2,1)
    for p = 1:nk 
        plot(line(k,:), 'r', 'DisplayName', 'Line Profile');
        hold on;
    end
        xlabel('Pixel');
        ylabel('mean intensity');
        title('mean image profiles');
    
        subplot(1,2,2)
        plot(column(k,:), 'r', 'DisplayName', 'Column Profile');
        hold on;

        legend show;
        xlabel('Pixel');
        ylabel('mean intensity');
        title('mean image profiles');

end