%% Afficher images SRS 

z_obs = 2;

n1 = 6; 
n2 = 1;
n3 = 4;
n4 = 3; 
n5 = 2;
I1 = squeeze(spectre(n1,:,:,z_obs)); % calcite
I2 = squeeze(spectre(n2,:,:,z_obs)); % fluo 
I3 = squeeze(spectre(n3,:,:,z_obs)); % ACC H2O 
I4 = squeeze(spectre(n4,:,:,z_obs)); % ACC Chira
I5 = squeeze(spectre(n5,:,:,z_obs)); % fluo 2

seuil_R2 = 1; % =1 fit parfait (aucun pixel surligné) 

figure(102); clf;
Imax = 6;
Imin= 5;

subplot(2,3,1);
imagesc(I1); caxis([Imin Imax]); colorbar;
title('calcite (I1)');
hold on;
contour(I1, 1, 'w', 'LineWidth', 1);
hold off;

subplot(2,3,3);
imagesc(I3); caxis([Imin Imax]); colorbar;
title('ACC-H₂O (I3)');
hold on;
