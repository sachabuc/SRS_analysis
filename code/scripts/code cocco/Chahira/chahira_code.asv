%% Image pour laquelle il semble que le le spectre de calcite est plus large côté ACC
figure(12)
ii=5;
imagesc(GOCEA1_space(:,:,3,ii)-mean(mean(GOCEA1_space(120:150,120:150,3,ii),1),2),[0 1])
colorbar
hold on;
bar_length_pixels = 75; 
y = 147;   
x = 10;                        
line([x x+bar_length_pixels], [y y], 'Color', 'k', 'LineWidth', 3)
text(x + bar_length_pixels/2, y-2, '10 µm', 'Color', 'w','HorizontalAlignment', 'center', 'FontSize', 10)
hold on; 
rectangle('Position', [72, 50 4, 4], 'EdgeColor', 'r',  'LineWidth', 2);
hold off 

%% Fitting d'une gaussienne calcilte sur les data qu'on a. Le fitting est peut être pas bon car j'ai changé certains parametres pendant l'écriture de mon rapport
% mais on voit ce qu'on a besoin de voir

%definition des des intensités 
spectre = permute(GOCEA1_space(:,:,:,:), [4, 1, 2, 3]);

I1 = mean(mean(spectre(2:11,25:29,64:68,8),2), 3);
I1 = (I1-I1(2))./max(I1-I1(2));
I1 = reshape(I1, [], 1);  % force I1 à être un vecteur colonne

I2 = mean(mean(spectre(2:11,60:64,40:44,7),2), 3); 
I2 = (I2-min(I2))./max(I2-min(I2));
I2 = reshape(I2, [], 1);  % force I2 à être un vecteur colonne

I3 = mean(mean(spectre(2:11,50:64,72:85,3),2), 3); 
I3 = (I3-min(I3))./max(I3-min(I3));
I3 = reshape(I3, [], 1);  % force I3 à être un vecteur colonne

I4 = mean(mean(spectre(2:11,100:105,75:85,5),2), 3); 
I4 = (I4-min(I4))./max(I4-min(I4));
I4 = reshape(I4, [], 1);  % force I4 à être un vecteur colonne

lam = [lambda(2:11)]; 
NU = (-1/1031 + 1./lam)*10^7;
NU = reshape(NU, [], 1);

%definition de la gaussienne

gaussian = @(p, x) p(1) * exp(-((x - p(2)).^2) / (2 * p(3)^2));


errfun1 = @(p) sum((gaussian(p, NU) - I1).^2);
p01= [1, 1084.64, 21.4];
p_fit1 = fminsearch(errfun1, p01);


errfun2 = @(p) sum((gaussian(p, NU) - I2).^2);
p_fit2 = fminsearch(errfun2, p01);

errfun3 = @(p) sum((gaussian(p, NU) - I3).^2);
p_fit3 = fminsearch(errfun3, p01);

errfun4 = @(p) sum((gaussian(p, NU) - I4).^2);
p_fit4 = fminsearch(errfun4, p01);

nu_fine = linspace(min(NU), max(NU)+30, 500);

fitted_curve_fine1 = gaussian(p_fit1, nu_fine);
fitted_curve_fine_norm1 = fitted_curve_fine1./max(fitted_curve_fine1);

fitted_curve_fine2 = gaussian(p_fit2, nu_fine);
fitted_curve_fine_norm2 = fitted_curve_fine2./max(fitted_curve_fine2);

fitted_curve_fine3 = gaussian(p_fit3, nu_fine);
fitted_curve_fine_norm3 = fitted_curve_fine3./max(fitted_curve_fine3);

fitted_curve_fine4 = gaussian(p_fit4, nu_fine);
fitted_curve_fine_norm4 = fitted_curve_fine4./max(fitted_curve_fine4);


figure(13)
plot(NU, I2,'r+', nu_fine,fitted_curve_fine_norm2, 'r-', LineWidth=1.5)
xlabel('\nu (cm^{-1})')
ylabel('Intensity (a.u)')
grid on

figure(14)
plot(NU, I1-min(I1)/max(I1-min(I1)),'b+', nu_fine-1.4,fitted_curve_fine_norm3, 'b-', LineWidth=1.5)
xlabel('\nu (cm^{-1})')
ylabel('Normalized Intensity')
grid on
legend('data', 'FWHM-2ps=10.7cm^{-1}')

