function img_corrected = correctfluo_julien(imgs,tau)

    img = squeeze(imgs);
    [Nx,Ny,nk] = size(img);

    Ifluo = img(:,:,2);
    Ilast = img(:,:,nk);

    img_corrected = zeros(size(img));

    Amap = (Ifluo - Ilast).*exp(2/tau);
    Cmap = Ilast;

    figure()
    subplot(1,2,1)
    imagesc(Amap);colorbar;
    title('Amap')
    subplot(1,2,2)
    imagesc(Cmap);colorbar;
    title('C')

    for k=1:nk
        
        img_corrected(:,:,k) = img(:,:,k) - Amap(:,:).*exp(-k/tau) + Cmap(:,:);
    
    end


end