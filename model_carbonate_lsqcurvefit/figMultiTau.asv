function figMultiTau(phase_model, wavenumber, tau_list_ps)
% Figure 2 : spectre total (analytique) pour plusieurs valeurs de
% tau_fwhm, pour visualiser l'effet de la reponse instrumentale sur la
% resolution spectrale du modele.
 
    figure('Color','white','Position',[100 100 1000 700]);
    hold on;
 
    colors = parula(numel(tau_list_ps));

    % Vitesse de la lumiere en cm/s
    c = 2.99792458e10;
 
    for i = 1:numel(tau_list_ps)
                
        tau_ps = tau_list_ps(i);

        % Largeur spectrale d'un pulse (cm^-1)
        fwhm_pulse = 0.441 / (c * tau_ps * 1e-12);

        % Pump et Stokes identiques
        fwhm_SRS = sqrt(2) * fwhm_pulse;

        % Conversion FWHM -> sigma
        sigma_inst_i = fwhm_SRS / 2.355;
        total_i = totalActiveSpectrum(phase_model, wavenumber, sigma_inst_i);
        plot(wavenumber, total_i, 'Color', colors(i,:), 'LineWidth', 2, ...
             'DisplayName', sprintf('\\tau = %d ps', tau_list_ps(i)));
    end

        % Amplitudes des phases actives 
    for k = 1:numel(phase_model)
        if ~phase_model(k).use
            continue
        end
        plot(NaN, NaN, 'LineStyle', 'none', 'Marker', 'none', ...
             'DisplayName', sprintf('%s : A = %.2f', phase_model(k).name, phase_model(k).A));
    end
 
    xlabel('Wavenumber (cm^{-1})','FontSize',12);
    ylabel('Intensity (a.u.)','FontSize',12);
    title('Modele total pour differentes largeurs instrumentales','FontSize',13);
    legend('Location','best');
    grid on; box on; set(gca,'FontSize',11);
end