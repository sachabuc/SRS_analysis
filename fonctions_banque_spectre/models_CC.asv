function signal_conv = models_CC(...
    wavenumber_sorted,...
    sp_sorted,...
    tau_fwhm,...
    display_figures,...
    A_ACC,...
    A_CCHH,...
    A_MHC,...
    A_VAT,...
    A_ARA,...
    A_CAL)
 
%% =======================
%      Carbonate phases
%% =======================

phase(1).name="ACC";
phase(1).A=A_ACC;
phase(1).nu=1075;
phase(1).FWHM=20;

phase(2).name="CCHH";
phase(2).A=A_CCHH;
phase(2).nu=1081;
phase(2).FWHM=16;

phase(3).name="MHC";
phase(3).A=A_MHC;
phase(3).nu=1079;
phase(3).FWHM=15;

phase(4).name="Vaterite";
phase(4).A=A_VAT;
phase(4).nu=1073;
phase(4).FWHM=12;

phase(5).name="Aragonite";
phase(5).A=A_ARA;
phase(5).nu=1085;
phase(5).FWHM=10;

phase(6).name="Calcite";
phase(6).A=A_CAL;
phase(6).nu=1086.5;
phase(6).FWHM=7;

%% --- Grille commune haute résolution ---
wn_min = min(wavenumber_sorted);
wn_max = max(wavenumber_sorted);
dw     = 0.05;                              % pas fin pour la convolution
wavenumber = wn_min : dw : wn_max;          % grille théorique
 

%% --- Modèle gaussien ---

signal=zeros(size(wavenumber));

signal_phase      = cell(length(phase),1);
signal_phase_conv = cell(length(phase),1);

for k = 1:length(phase)

    if phase(k).A == 0
        continue
    end

    sigma = phase(k).FWHM/2.355;

    % -------- Gaussienne normalisée --------
    G = phase(k).A/(sqrt(2*pi)*sigma) .* ...
        exp(-(wavenumber-phase(k).nu).^2/(2*sigma^2));

    signal_phase{k} = G;

    % -------- Convolution instrumentale --------
    if tau_fwhm > 0

        sigma_wn = tau_fwhm/(2*sqrt(2*log(2)));

        half_win  = 4*sigma_wn;
        wn_kernel = -half_win:dw:half_win;

        kernel = exp(-wn_kernel.^2/(2*sigma_wn^2));
        kernel = kernel/sum(kernel);

        n_pad = length(wn_kernel);

        G_pad = [G(1)*ones(1,n_pad) G G(end)*ones(1,n_pad)];

        G_conv = conv(G_pad,kernel,'same');
        G_conv = G_conv(n_pad+1:n_pad+length(G));

    else

        G_conv = G;

    end

    signal_phase_conv{k} = G_conv;

    signal = signal + G_conv;

end
 

 
%% --- Affichage ---

if display_figures == true 
    for k=1:length(phase)

    if phase(k).A==0
        continue
    end

    sigma=phase(k).FWHM/2.355;

    G = phase(k).A/(sqrt(2*pi)*sigma).* ...
        exp(-(wavenumber-phase(k).nu).^2/(2*sigma^2));

    plot(wavenumber,...
         G/max(signal_conv),...
         '--','LineWidth',1)

    end
    plot(wavenumber,...
     signal_display,...
     'k','LineWidth',3)

end

end




